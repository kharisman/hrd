APP_NAME="HRD ITB PalComTech"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack

# Database HRD (semua tabel memakai prefix hrd_)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrd
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=hrd_

SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# API Akademik PalComTech (eUniversity). Minta API key ke tim eUniversity.
PCT_API_URL=https://beta1.palcomtech.org/api/v1
PCT_API_KEY=
